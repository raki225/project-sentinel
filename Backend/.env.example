# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/project_sentinel

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── AI Provider (OpenAI-compatible chat/completions endpoint) ──
# Paste your provider's values here. No code changes needed.
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# ── Geocoding (Google Maps) ──────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated extra origins to allow, beyond what's always allowed automatically:
# any http://localhost:<port> and any https://*.vercel.app deployment (previews + production).
# Only needed for things like a custom production domain that isn't *.vercel.app.
CORS_ORIGIN=http://localhost:3000,https://project-sentinel-rwxg.vercel.app

# ── Uploads ───────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Government Open Data ingestion ───────────────────────────
# Shared data.gov.in API key (one account key works across all its resource
# APIs — register free at https://data.gov.in). Not required for file-url
# sources (bulk CSV/XLSX/ZIP downloads need no key).
GOV_DATA_API_KEY=
GOV_DATA_API_BASE_URL=https://api.data.gov.in
# Path (relative to Backend/) to your dataset source config — copy
# config/gov-data-sources.example.json to config/gov-data-sources.json,
# fill in real resource ids / dataset URLs, then point this at it.
# Left empty by default: with no sources configured, the API serves a
# clearly-labeled demo dataset instead of a confidential/fabricated one.
GOV_DATA_SOURCES_FILE=
GOV_DATA_SYNC_CRON=0 3 * * *
GOV_DATA_SYNC_ON_STARTUP=true
